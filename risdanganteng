local function valid(i)
    if not i then return false end
    local ok, p = pcall(function() return i.Parent end)
    return ok and p ~= nil
end

local function isRod(t)
    if not valid(t) or not t:IsA("Tool") then return false end
    local m = t:FindFirstChild("Mechanics")
    local r = m and m:FindFirstChild("Remotes")
    return valid(r) and valid(r:FindFirstChild("CastEvent")) and valid(r:FindFirstChild("MiniGame"))
end

local function equipRod()
    local c = LP.Character
    if not c then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local equipped = c:FindFirstChildOfClass("Tool")
    if isRod(equipped) then return true end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isRod(t) then pcall(function() hum:EquipTool(t) end) return true end
        end
    end
    for _, t in ipairs(c:GetChildren()) do
        if isRod(t) then pcall(function() hum:EquipTool(t) end) return true end
    end
    return false
end

local function findRod()
    local c = LP.Character
    if not c then return nil end
    local eq = c:FindFirstChildOfClass("Tool")
    if isRod(eq) then
        local m = eq:FindFirstChild("Mechanics")
        return m and m:FindFirstChild("Remotes")
    end
    for _, t in ipairs(c:GetChildren()) do
        if isRod(t) then
            local m = t:FindFirstChild("Mechanics")
            return m and m:FindFirstChild("Remotes")
        end
    end
    return nil
end

local function getRemote(n)
    local r = findRod()
    if not valid(r) then return nil end
    local x = r:FindFirstChild(n)
    return valid(x) and x or nil
end

local hooked = false
local function hook()
    if hooked or not hookmetamethod then return end
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local m = getnamecallmethod()
        pcall(function()
            if m == "FireServer" and self and self.Name == "TandaSeruBersama" then sig:Fire() end
        end)
        return old(self, ...)
    end)
    setreadonly(mt, true)
    hooked = true
end

