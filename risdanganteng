local function getFishNameList()
    local names = {}
    local r = RS:FindFirstChild("Remote")
    r = r and r:FindFirstChild("Trade")
    local remote = r and r:FindFirstChild("DaftarIkan")
    if remote then
        local ok, items = pcall(function() return remote:InvokeServer("") end)
        if ok and items then
            local counts = {}
            for _, item in ipairs(items) do
                if item.nama then
                    counts[item.nama] = (counts[item.nama] or 0) + 1
                end
            end
            for name, count in pairs(counts) do
                table.insert(names, {name = name, count = count})
            end
            table.sort(names, function(a, b) return string.lower(a.name) < string.lower(b.name) end)
        end
    end
    if #names == 0 then return {"(no fish)"} end
    local formatted = {}
    for _, entry in ipairs(names) do
        table.insert(formatted, entry.name .. " x" .. entry.count)
    end
    return formatted
end

