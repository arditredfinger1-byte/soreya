local function waitTrig(expectedCount)
    local t = tick()
    while triggerCount <= expectedCount
      and S.Running
      and findRod()
      and (tick() - t) <= S.Timeout do
        task.wait(0.5)
    end

    if triggerCount > expectedCount then
        task.wait(MINIGAME_DELAY)
        return true
    end

    return false
end

local function cycle()
    if not findRod() then
        equipRod()
        task.wait(0.3)
    end
    if not findRod() then
        task.wait(0.5)
        return
    end

    local beforeCast = triggerCount

    if not cast() then return end

    if not waitTrig(beforeCast) then
        return
    end

    if not findRod() then
        equipRod()
        task.wait(0.1)
    end

    if findRod() then mini() end
end

