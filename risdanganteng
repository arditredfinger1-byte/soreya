local min = false
local function tryMin()
    min = not min
    for _, fn in ipairs({
        function() return Window.Minimize and Window:Minimize() end,
        function() return Window.ToggleMinimize and Window:ToggleMinimize() end,
        function() return Window.SetMinimized and Window:SetMinimized(min) end,
        function() return Window.Toggle and Window:Toggle() end,
    }) do
        local ok, r = pcall(fn) if ok and r then return end
    end
end

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.L then tryMin() end
end)

