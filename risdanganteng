        LT.EnvironmentDiffuseScale = 0; LT.EnvironmentSpecularScale = 0
        LT.ClockTime = 12; LT.GeographicLatitude = 0; LT.ShadowSoftness = 0
    end)

    pcall(function()
        WS.GlobalWind = Vector3.zero
        WS.FallenPartsDestroyHeight = -1e6
    end)

    pcall(function()
        if sethiddenproperty then pcall(sethiddenproperty, TR, "Decoration", false) end
        TR.WaterReflectance = 0; TR.WaterWaveSize = 0
        TR.WaterWaveSpeed = 0; TR.WaterTransparency = 1
    end)

    pcall(function()
        SS.AmbientReverb = Enum.ReverbType.NoReverb
        SS.DistanceFactor = 0; SS.DopplerScale = 0
        SS.RespectFilteringEnabled = false
    end)

    local SP = Enum.Material.SmoothPlastic
    local seen = setmetatable({}, {__mode="k"})

    local function optimize(o)
        if seen[o] then return end
        seen[o] = true
        local c = o.ClassName

        if c == "Sound" then
            pcall(function() o.Volume=0; o.Playing=false; o.Enabled=false; o.Looped=false end)
        elseif c == "ParticleEmitter" then
            pcall(function() o.Rate=0; o.Enabled=false; o.Lifetime=NumberRange.new(0) end)
        elseif c=="Trail" or c=="Beam" or c=="Fire" or c=="Smoke" or c=="Sparkles" then
            pcall(function() o.Enabled=false end)
        elseif c == "Explosion" then
            pcall(function() o.BlastPressure=0; o.BlastRadius=0; o.DestroyJointRadiusPercent=0 end)
        elseif c=="PointLight" or c=="SpotLight" or c=="SurfaceLight" then
            pcall(function() o.Enabled=false; o.Brightness=0; o.Range=0 end)
        elseif c == "Decal" then
            pcall(function() o.Transparency = 1 end)
        elseif c == "Texture" then
            pcall(function() o.Transparency=1; o.StudsPerTileU=512; o.StudsPerTileV=512 end)
        elseif c == "Sky" then
            pcall(function()
                o.SkyboxBk=""; o.SkyboxDn=""; o.SkyboxFt=""
                o.SkyboxLf=""; o.SkyboxRt=""; o.SkyboxUp=""
                o.CelestialBodiesShown=false; o.StarCount=0
            end)
        elseif c == "Atmosphere" then
            pcall(function()
                o.Density=0; o.Haze=0; o.Glare=0; o.Offset=0
                o.Color=Color3.new(); o.Decay=Color3.new()
            end)
        elseif c == "Clouds" then
            pcall(function() o.Enabled=false; o.Cover=0; o.Density=0; o.Transparency=1 end)
        elseif o:IsA("PostEffect") then
            pcall(function() o.Enabled = false end)
        elseif o:IsA("MeshPart") then
            pcall(function()
                o.Material=SP; o.Reflectance=0; o.CanQuery=false; o.CanTouch=false
                o.CastShadow=false
                o.RenderFidelity=Enum.RenderFidelity.Performance
                o.CollisionFidelity=Enum.CollisionFidelity.Box
            end)
        elseif o:IsA("BasePart") then
            pcall(function()
                o.Material=SP; o.Reflectance=0; o.CanQuery=false
                o.CanTouch=false; o.CastShadow=false
            end)
        elseif o:IsA("Humanoid") then
            pcall(function() o.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
        end
    end

    for _,v in ipairs(WS:GetDescendants()) do optimize(v) end
    WS.DescendantAdded:Connect(optimize)
    for _,v in ipairs(RS:GetDescendants()) do optimize(v) end
    RS.DescendantAdded:Connect(optimize)
    for _,v in ipairs(LT:GetDescendants()) do optimize(v) end
    LT.DescendantAdded:Connect(optimize)

    if LP then
        for _,v in ipairs(LP:GetDescendants()) do optimize(v) end
        LP.DescendantAdded:Connect(optimize)
    end
end

