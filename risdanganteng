local function calculateTargetAndFilter()
    local items = getFishList()
    local filtered = {}

    for _, item in ipairs(items) do
        local pass = true
        if #S.TradeRarity > 0 then
            local ok = false
            for _, r in ipairs(S.TradeRarity) do
                if r == item.rarity then ok = true break end
            end
            if not ok then pass = false end
        end
        if pass and #S.TradeFishName > 0 then
            local ok = false
            for _, n in ipairs(S.TradeFishName) do
                if item.nama == n then ok = true break end
            end
            if not ok then pass = false end
        end
        if pass and S.TradeFavorite then
            if S.TradeFavorite == "Favorite Only" and item.favorit ~= true then pass = false end
            if S.TradeFavorite == "Non-Favorite" and item.favorit ~= false then pass = false end
        end
        if pass then table.insert(filtered, item) end
    end

    local limit = MAX_IKAN_PER_TRADE
    if S.TradeQuantity and S.TradeQuantity > 0 then
        limit = math.min(S.TradeQuantity, MAX_IKAN_PER_TRADE)
    end

    local limited = {}
    for i = 1, math.min(limit, #filtered) do
        table.insert(limited, filtered[i])
    end

    return limited
end

local function resetTradeTracker()
    tradeState.SentIkan = {}
    tradeState.SentToTrade = false
    tradeState.TargetCount = 0
    tradeState.Phase = nil
    tradeState.ReadyAt = 0
    tradeState.ConfirmAt = 0
end

local function startCountdownThread()
    if countdownThread then return end
    countdownThread = task.spawn(function()
        while S.TradeRunning or tradeState.Active do
            if tradeState.Phase == "WAIT_READY" 
               and tradeState.ReadyAt > 0 
               and tick() >= tradeState.ReadyAt 
               and not tradeState.MyReady then
                setReady()
                tradeState.Phase = "WAIT_CONFIRM"
                tradeState.ConfirmAt = tick() + CONFIRM_DELAY
            end

            if tradeState.Phase == "WAIT_CONFIRM" 
               and tradeState.ConfirmAt > 0 
               and tick() >= tradeState.ConfirmAt 
               and not tradeState.MyConfirm then
                confirmTrade()
                tradeState.Phase = nil
            end

            task.wait(0.2)
        end
        countdownThread = nil
    end)
end

local tradeMulaiConn = nil
local tradeUpdateConn = nil
local tradeSelesaiConn = nil

local function setupTradeListeners()
    if tradeMulaiConn then return end

    local tawaran = getTradeRemote("TawaranMasuk")
    if tawaran then
        tawaran.OnClientEvent:Connect(function(data)
            if type(data) ~= "table" then return end
            pcall(function()
                Window:Notify({
                    Title="Trade Masuk",
                    Content=tostring(data.nama)..(S.AutoAccept and " (auto ✅)" or " (manual)"),
                    Duration=3,
                    Icon="handshake"
                })
            end)
            if S.AutoAccept then
                task.spawn(function()
                    task.wait(0.5)
                    acceptTrade()
                end)
            end
        end)
    end

    local mulai = getTradeRemote("TradeMulai")
    if mulai then
        tradeMulaiConn = mulai.OnClientEvent:Connect(function(data)
            if type(data) ~= "table" then return end
            tradeState.Active = true
            resetTradeTracker()
            pcall(function()
                Window:Notify({Title="Trade", Content="Mulai: "..tostring(data.nama), Duration=2, Icon="handshake"})
            end)
        end)
    end

    local update = getTradeRemote("TradeUpdate")
    if update then
        tradeUpdateConn = update.OnClientEvent:Connect(function(data)
            if type(data) ~= "table" then return end

            tradeState.LastUpdateAt = tick()

            if data.kamu then
                tradeState.MyConfirm = data.kamu.konfirmasi == true
                tradeState.MyReady = data.kamu.siap == true
            end
            if data.lawan then
                tradeState.TheirConfirm = data.lawan.konfirmasi == true
                tradeState.TheirReady = data.lawan.siap == true
            end

            -- ===== RECEIVER MODE =====
            -- Receiver cuma nerima, siap, konfirmasi. TIDAK setor ikan.
            if not S.TradeRunning and tradeState.Active then

                -- AUTO READY (SetSiap)
                if S.ReceiverAutoReady and not tradeState.MyReady then
                    if tradeState.TheirReady or data.tahap == "konfirmasi" then
                        task.spawn(function()
                            task.wait(0.3)
                            if not tradeState.MyReady and tradeState.Active then
                                setReady()
                            end
                        end)
                    end
                end

                -- AUTO CONFIRM (Konfirmasi)
                if S.ReceiverAutoConfirm and not tradeState.MyConfirm then
                    if tradeState.TheirConfirm or data.tahap == "konfirmasi" then
                        task.spawn(function()
                            task.wait(0.3)
                            if not tradeState.MyConfirm and tradeState.Active then
                                confirmTrade()
                            end
                        end)
                    end
                end

                return   -- receiver selesai, jangan lanjut ke sender logic
            end

            if not S.TradeRunning then return end

            if data.tahap == "susun" then
                task.spawn(function()
                    if not tradeState.SentToTrade then
                        local filtered = calculateTargetAndFilter()
                        tradeState.TargetCount = #filtered
                        tradeState.SentToTrade = true

                        if tradeState.TargetCount == 0 then
                            tradeState.Phase = "WAIT_READY"
                            tradeState.ReadyAt = tick() + READY_DELAY
                            startCountdownThread()
                            return
                        end

                        for _, item in ipairs(filtered) do
                            if not S.TradeRunning then break end
                            if addItemToTrade(item.uid) then
                                tradeState.SentIkan[item.uid] = true
                            end
                            task.wait(0.15)
                        end

                        tradeState.Phase = "WAIT_READY"
                        tradeState.ReadyAt = tick() + READY_DELAY
                        startCountdownThread()
                    end
                end)
            end

            if tradeState.TheirReady and not tradeState.MyReady then
                task.spawn(function()
                    task.wait(0.3)
                    if not tradeState.MyReady then
                        setReady()
                        if tradeState.Phase ~= "WAIT_CONFIRM" then
                            tradeState.Phase = "WAIT_CONFIRM"
                            tradeState.ConfirmAt = tick() + CONFIRM_DELAY
                        end
                    end
                end)
            end

            if tradeState.TheirConfirm and not tradeState.MyConfirm then
                task.spawn(function()
                    task.wait(0.3)
                    if not tradeState.MyConfirm then
                        confirmTrade()
                        tradeState.Phase = nil
                    end
                end)
            end

            if data.tahap == "konfirmasi" then
                if not tradeState.MyConfirm then
                    task.spawn(function()
                        task.wait(0.3)
                        if not tradeState.MyConfirm then
                            confirmTrade()
                        end
                    end)
                end
            end
        end)
    end

    -- ===== NOTIF TRADE SELESAI =====
    local selesai = getTradeRemote("TradeSelesai")
    if selesai then
        tradeSelesaiConn = selesai.OnClientEvent:Connect(function(success, msg)
            pcall(function()
                Window:Notify({
                    Title="Trade Selesai",
                    Content=success and ("✅ "..tostring(msg)) or ("❌ "..tostring(msg)),
                    Duration=3,
                    Icon=success and "check" or "x"
                })
            end)
            tradeState.Active = false
            resetTradeTracker()
        end)
    end
end

setupTradeListeners()

local function startAutoTradeCore()
    if autoTradeThread then return end
    if not S.SelectedPlayer or S.SelectedPlayer == "(no player)" then
        pcall(function() Window:Notify({Title="Trade", Content="Pilih player dulu!", Duration=3, Icon="x"}) end)
        return
    end

    local userId = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == S.SelectedPlayer then
            userId = plr.UserId
            break
        end
    end

    if not userId then
        pcall(function() Window:Notify({Title="Trade", Content="Player gak ada", Duration=3, Icon="x"}) end)
        return
    end

    S.TradeRunning = true
    autoTradeThread = task.spawn(function()
        while S.TradeRunning do
            if not tradeState.Active then
                resetTradeTracker()
                sendTradeInvite(userId)
            else
                if tradeState.LastUpdateAt and tick() - tradeState.LastUpdateAt > 15 then
                    tradeState.Active = false
                    resetTradeTracker()
                end
            end

            local t = tick()
            while S.TradeRunning and tick() - t < 3 do task.wait(0.2) end
        end
        autoTradeThread = nil
    end)
end

local function stopAutoTradeCore()
    S.TradeRunning = false
    autoTradeThread = nil
    tradeState.Active = false
end

local favRemote = nil
pcall(function()
    local r = RS:FindFirstChild("Remote")
    r = r and r:FindFirstChild("Mancing")
    favRemote = r and r:FindFirstChild("TandaiFavorit")
end)

local ambilRemote = nil
pcall(function()
    local r = RS:FindFirstChild("Remote")
    r = r and r:FindFirstChild("Inventaris")
    ambilRemote = r and r:FindFirstChild("AmbilSemua")
end)

local function getInv()
    if not ambilRemote then return {} end
    local ok, r = pcall(function() return ambilRemote:InvokeServer() end)
    return (ok and r) or {}
end

local function contains(list, val)
    for _, v in ipairs(list) do if v == val then return true end end
    return false
end

local function favMatch(item)
    if #S.FavRarity > 0 then
        if not contains(S.FavRarity, item.rarity) then return false end
    end
    if #S.FavMutasi > 0 then
        if not contains(S.FavMutasi, item.mutasi) then return false end
    end
    return true
end

local function doFav()
    if not favRemote then return end
    local items = getInv()
    for _, item in ipairs(items) do
        if favMatch(item) and item.favorit == false then
            pcall(function() favRemote:FireServer(item.uid, true) end)
            task.wait(0.02)
        end
    end
end

local function doUnfavAll()
    if not favRemote then return 0, 0 end
    local items = getInv()
    local unfaved = 0
    for _, item in ipairs(items) do
        if item.favorit == true then
            pcall(function() favRemote:FireServer(item.uid, false) end)
            unfaved = unfaved + 1
            task.wait(0.02)
        end
    end
    return unfaved, #items
end

local favThread = nil
local function startAutoFav()
    if favThread then return end
    S.AutoFav = true
    favThread = task.spawn(function()
        while S.AutoFav do
            doFav()
            local t = tick()
            while S.AutoFav and tick() - t < S.FavInterval do task.wait(0.05) end
        end
        favThread = nil
    end)
end
local function stopAutoFav() S.AutoFav = false favThread = nil end

